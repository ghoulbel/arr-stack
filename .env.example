# Copy to .env and fill in real values. Never commit .env.
DUPLICATI_PW=change-me
ENCRYPTION_KEY=change-me
VPN_USER=change-me
VPN_PASS=change-me
WUD_REGISTRY_LSCR_PRIVATE_USERNAME=change-me
WUD_REGISTRY_LSCR_PRIVATE_TOKEN=change-me
# Tailscale IPv4. Written by ../bootstrap.sh. No longer referenced by
# docker-compose.yaml -- the *arr admin UIs and the qBittorrent WebUI are now
# published on the LAN so you can reach them from any device at home. Kept
# because bootstrap.sh publishes it and it is useful for diagnostics.
TAILSCALE_IP=100.102.27.93
TAILSCALE_DNS=rog-strix.zapus-pence.ts.net
# GID of the host's `render` group, written by ../bootstrap.sh. Used on the AMD
# branch (`git checkout amd`) so jellyfin can reach /dev/dri/renderD128 for
# VAAPI hardware transcoding. NEVER hard-code this number: 993 was `render` on
# the old MiniX, but 993 is the `sgx` group on ROG-Strix (render is 990 there).
# A wrong value does not error -- jellyfin silently loses the render node and
# falls back to CPU transcoding. Ignored on the main branch, which uses CUDA.
RENDER_GID=989
VIDEO_GID=44
# Container user. Must be a uid that EXISTS on the host, otherwise the agent
# (uid 1000) cannot read or write the *arr configs at all. 1026 was inherited
# from the dead MiniX server and has no passwd entry here.
#
# This does NOT affect access to the NAS. /mnt/synology/{downloads,tv,music,
# movies} are NFS mounts owned by uid 1026 but MODE 777, so any uid can read and
# write them regardless of what PUID is set to. uid 1026 is a NAS-side identity
# only; it never needed to exist on this host.
#
# Setting PUID back to 1026 would also work for the NAS (mode 777 again), but it
# would re-break local config administration, so 1000 is the right value.
PUID=1000
PGID=1000

