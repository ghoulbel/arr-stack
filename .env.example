# Copy to .env and fill in real values. Never commit .env.
DUPLICATI_PW=change-me
ENCRYPTION_KEY=change-me
VPN_USER=change-me
VPN_PASS=change-me
WUD_REGISTRY_LSCR_PRIVATE_USERNAME=change-me
WUD_REGISTRY_LSCR_PRIVATE_TOKEN=change-me
# Tailscale IPv4. Written by ../bootstrap.sh. Used to publish the *arr admin
# UIs and the qBittorrent WebUI on the tailnet without exposing them to the LAN.
TAILSCALE_IP=100.102.27.93
TAILSCALE_DNS=rog-strix.zapus-pence.ts.net
# Container user. Must be a uid that EXISTS on the host, otherwise files end up
# owned by a number nothing can be administered with. 1026 was inherited from the
# dead MiniX server and has no passwd entry here, which meant the agent (uid 1000)
# could not read or write the *arr configs at all.
PUID=1000
PGID=1000

